# Declare — ESP32-C6 biometric CSI sensor
# Trimmed from esp32-csi-node for single-device public release.

CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Compiler optimization
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# LWIP: extended socket options for UDP
CONFIG_LWIP_SO_RCVBUF=y

# FreeRTOS: main task stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# WiFi network defaults (overridden by NVS)
CONFIG_CSI_WIFI_CHANNEL=6
CONFIG_CSI_TARGET_PORT=5005

# WiFi IRAM placement for cache race defense
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=y

# Timer task stack (edge processing uses timers for streaming)
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=8192

# Console to UART (non-JTAG board)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
